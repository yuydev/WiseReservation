<view class="order-hall-page">
  <!-- 页面标题区 -->
  <view class="page-header">
    <text class="page-title">抢单大厅</text>
    <text class="page-subtitle">{{availableOrders.length}} 个可用订单</text>
  </view>

  <!-- 筛选区域 -->
  <view class="filter-bar">
    <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">
      <text>全部</text>
    </view>
    <view class="filter-item {{currentFilter === 'nearby' ? 'active' : ''}}" bindtap="switchFilter" data-filter="nearby">
      <text>附近</text>
    </view>
    <view class="filter-item {{currentFilter === 'urgent' ? 'active' : ''}}" bindtap="switchFilter" data-filter="urgent">
      <text>紧急</text>
    </view>
    <view class="filter-item {{currentFilter === 'highValue' ? 'active' : ''}}" bindtap="switchFilter" data-filter="highValue">
      <text>高价值</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y bindscrolltolower="loadMore">
    <view class="order-card card" wx:for="{{availableOrders}}" wx:key="id" bindtap="goOrderDetail" data-id="{{item.id}}">
      <view class="order-card-header">
        <view class="order-type-tag" style="background-color: {{item.tagColor}}">
          <text>{{item.typeText}}</text>
        </view>
        <text class="order-time">{{item.publishTime}}</text>
      </view>

      <view class="order-card-body">
        <view class="order-main-info">
          <text class="order-title">{{item.title}}</text>
          <text class="order-desc">{{item.description}}</text>
        </view>
        <view class="order-detail-info">
          <view class="detail-row">
            <text class="detail-icon">📍</text>
            <text class="detail-text">{{item.destination}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-icon">📦</text>
            <text class="detail-text">{{item.materialInfo}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-icon">⏰</text>
            <text class="detail-text">要求 {{item.deadline}} 前送达</text>
          </view>
        </view>
      </view>

      <view class="order-card-footer">
        <view class="order-price">
          <text class="price-label">运费</text>
          <text class="price-value">¥{{item.price}}</text>
        </view>
        <view class="order-distance" wx:if="{{item.distance}}">
          <text>{{item.distance}}km</text>
        </view>
        <button class="grab-btn" catchtap="grabOrder" data-id="{{item.id}}">抢单</button>
      </view>
    </view>

    <view class="empty-state" wx:if="{{availableOrders.length === 0 && !loading}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无可抢订单</text>
    </view>

    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </scroll-view>
</view>
