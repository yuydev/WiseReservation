.order-hall-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  padding: 30rpx 24rpx 20rpx;
  background-color: #ffffff;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.page-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
}

/* 筛选区域 */
.filter-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
}

.filter-item.active {
  color: #ffffff;
  background-color: #4CAF50;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx 24rpx;
}

.order-card {
  margin-bottom: 20rpx;
}

.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-type-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
}

.order-card-body {
  margin-bottom: 20rpx;
}

.order-main-info {
  margin-bottom: 16rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.order-desc {
  font-size: 26rpx;
  color: #666666;
  display: block;
}

.order-detail-info {
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #666666;
}

.order-card-footer {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-price {
  flex: 1;
}

.price-label {
  font-size: 22rpx;
  color: #999999;
  margin-right: 8rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF5722;
}

.order-distance {
  font-size: 24rpx;
  color: #999999;
  margin-right: 20rpx;
}

.grab-btn {
  padding: 12rpx 36rpx;
  background-color: #FF5722;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 28rpx;
  border: none;
  line-height: 1.5;
  min-height: auto;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999999;
}
