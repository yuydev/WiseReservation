.profile-page {
  padding: 20rpx 24rpx;
  padding-bottom: 60rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  margin-right: 24rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background-color: rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.user-company {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.user-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计数据 */
.stats-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #f0f0f0;
}

/* 菜单 */
.menu-section {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 退出按钮 */
.logout-btn {
  margin-top: 40rpx;
  padding: 24rpx;
  text-align: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #F44336;
}
