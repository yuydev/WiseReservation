.reservations-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #ffffff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 状态标签 */
.status-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  overflow-x: auto;
  white-space: nowrap;
}

.status-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.status-tab.active {
  color: #4CAF50;
  background-color: #E8F5E9;
  font-weight: 500;
}

.tab-badge {
  margin-left: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #FF5722;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 列表 */
.reservation-list {
  flex: 1;
  padding: 20rpx 24rpx;
}

.reservation-item {
  margin-bottom: 20rpx;
}

.reservation-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.reservation-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.reservation-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending {
  color: #FF9800;
  background-color: #FFF3E0;
}

.status-approved {
  color: #4CAF50;
  background-color: #E8F5E9;
}

.status-rejected {
  color: #F44336;
  background-color: #FFEBEE;
}

.status-completed {
  color: #2196F3;
  background-color: #E3F2FD;
}

.status-cancelled {
  color: #9E9E9E;
  background-color: #F5F5F5;
}

.reservation-body {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.reservation-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.create-time {
  font-size: 22rpx;
  color: #999999;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.btn-cancel, .btn-approve {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  line-height: 1.5;
  min-height: auto;
}

.btn-cancel {
  color: #999999;
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
}

.btn-approve {
  color: #ffffff;
  background-color: #4CAF50;
  border: none;
}

/* FAB按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999999;
}
