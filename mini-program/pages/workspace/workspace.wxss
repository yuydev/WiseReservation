.workspace-page {
  padding-bottom: 20rpx;
}

/* 角色切换标签 */
.role-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
}

.role-tab-list {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.role-tab {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #f5f5f5;
}

.role-tab.active {
  color: #4CAF50;
  background-color: #E8F5E9;
  font-weight: 600;
}

.notification-icon {
  position: relative;
  padding: 10rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #FF5722;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

/* 数据概览卡片 */
.stats-card {
  display: flex;
  margin: 20rpx 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 16rpx;
  color: #ffffff;
}

.stats-left {
  flex: 1;
}

.stats-right {
  flex: 1;
  text-align: right;
}

.stats-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.stats-value-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.stats-right .stats-value-row {
  justify-content: flex-end;
}

.stats-value {
  font-size: 56rpx;
  font-weight: 700;
}

.stats-total {
  font-size: 32rpx;
  opacity: 0.8;
  margin-left: 4rpx;
}

.stats-icon {
  margin-left: 12rpx;
  font-size: 36rpx;
}

.stats-unit {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 核心能力 */
.capabilities-card {
  margin: 0 24rpx;
}

.capabilities-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.capabilities-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
}

.title-indicator {
  width: 6rpx;
  height: 28rpx;
  background-color: #4CAF50;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.capabilities-count {
  font-size: 24rpx;
}

.capabilities-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 0;
}

.capability-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.capability-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.capability-name {
  font-size: 24rpx;
  color: #333333;
}

/* 待办预警 */
.alerts-section {
  margin: 20rpx 24rpx;
}

.alerts-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.alerts-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
}

.alerts-icon {
  margin-right: 8rpx;
}

.more-link {
  font-size: 26rpx;
}

.alert-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.alert-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
}

.alert-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.alert-desc {
  font-size: 24rpx;
  color: #999999;
}

.alert-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.alert-time {
  font-size: 24rpx;
  color: #999999;
}

.alert-arrow {
  font-size: 32rpx;
  color: #cccccc;
}
